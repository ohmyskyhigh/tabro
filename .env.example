RELAY_HOST=127.0.0.1
# Port 0 allocates free ports; use the published runtime.json to discover them.
RELAY_MCP_PORT=0
RELAY_WS_PORT=0
RELAY_DB_PATH=.relay-data/relay.sqlite
RELAY_LOG_LEVEL=info
RELAY_HEARTBEAT_TIMEOUT_MS=45000
RELAY_ERROR_THRESHOLD=3
RELAY_LEASE_TTL_MS=60000
RELAY_ADMIN_TOKEN=change-me-before-use
