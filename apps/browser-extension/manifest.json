{
  "manifest_version": 3,
  "name": "Tabro",
  "version": "0.3.1",
  "key": "",
  "description": "Connect this Chrome profile to the local Tabro broker.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "tabGroups", "debugger", "nativeMessaging", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "options_page": "options.html",
  "action": {
    "default_title": "Tabro Settings"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
