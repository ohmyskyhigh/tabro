    { "method": "Runtime.disable", "scope": "managed_tab", "childSessions": false },
    { "method": "Runtime.enable", "scope": "managed_tab", "childSessions": false },
    { "method": "Runtime.evaluate", "scope": "managed_tab", "childSessions": false },
    { "method": "Runtime.getProperties", "scope": "managed_tab", "childSessions": false },
    { "method": "Runtime.releaseObject", "scope": "managed_tab", "childSessions": false },
    { "method": "Runtime.releaseObjectGroup", "scope": "managed_tab", "childSessions": false }
  ]
}
