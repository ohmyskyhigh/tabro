{
  "manifestVersion": 1,
  "manifestId": "octopus-extension-baseline-v1",
  "profile": "conservative",
  "relayProtocolVersion": 2,
  "debuggerProtocolVersion": "1.3",
  "extensionVersion": {
    "minInclusive": null,
    "maxExclusive": null
  },
  "browser": {
    "products": ["Chrome", "Chromium", "AdsPower"],
    "minMajor": null,
    "maxMajor": null
  },
  "features": {
    "browserInventory": true,
    "tabGroups": true,
    "debuggerAttachment": true,
    "cdpEvents": true,
    "attemptReconciliation": true,
    "flattenedChildSessions": false
  },
  "limits": {
    "maxEnvelopeBytes": 1048576,
    "maxInventoryWindows": 128,
    "maxTabsPerWindow": 2048,
    "maxGroupsPerWindow": 512,
    "maxActiveAttempts": 64,
    "maxRecentAttemptOutcomes": 200
  },
  "cdpMethods": [
    { "method": "Accessibility.disable", "scope": "managed_tab", "childSessions": false },
    { "method": "Accessibility.enable", "scope": "managed_tab", "childSessions": false },
    { "method": "Accessibility.getFullAXTree", "scope": "managed_tab", "childSessions": false },
    { "method": "Accessibility.getPartialAXTree", "scope": "managed_tab", "childSessions": false },
    { "method": "Accessibility.queryAXTree", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.describeNode", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.disable", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.enable", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.focus", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.getBoxModel", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.getDocument", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.getOuterHTML", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.querySelector", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.querySelectorAll", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.removeAttribute", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.requestNode", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.resolveNode", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.setAttributeValue", "scope": "managed_tab", "childSessions": false },
    { "method": "DOM.setFileInputFiles", "scope": "managed_tab", "childSessions": false },
    { "method": "Emulation.clearDeviceMetricsOverride", "scope": "managed_tab", "childSessions": false },
    { "method": "Emulation.setDeviceMetricsOverride", "scope": "managed_tab", "childSessions": false },
    { "method": "Emulation.setScrollbarsHidden", "scope": "managed_tab", "childSessions": false },
    { "method": "Input.dispatchKeyEvent", "scope": "managed_tab", "childSessions": false },
    { "method": "Input.dispatchMouseEvent", "scope": "managed_tab", "childSessions": false },
    { "method": "Input.insertText", "scope": "managed_tab", "childSessions": false },
    { "method": "Input.setIgnoreInputEvents", "scope": "managed_tab", "childSessions": false },
    { "method": "Network.disable", "scope": "managed_tab", "childSessions": false },
    { "method": "Network.enable", "scope": "managed_tab", "childSessions": false },
    { "method": "Network.getResponseBody", "scope": "managed_tab", "childSessions": false },
    { "method": "Network.setCacheDisabled", "scope": "managed_tab", "childSessions": false },
    { "method": "Page.bringToFront", "scope": "managed_tab", "childSessions": false },
    { "method": "Page.captureScreenshot", "scope": "managed_tab", "childSessions": false },
    { "method": "Page.disable", "scope": "managed_tab", "childSessions": false },
    { "method": "Page.enable", "scope": "managed_tab", "childSessions": false },
    { "method": "Page.getFrameTree", "scope": "managed_tab", "childSessions": false },
    { "method": "Page.getLayoutMetrics", "scope": "managed_tab", "childSessions": false },
